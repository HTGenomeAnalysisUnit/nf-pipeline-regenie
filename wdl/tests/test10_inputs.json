{
  "## TEST 10": "BGEN input - step2 split - quant phenotype - premade step1 predictions",

  "RegenieGWAS.project": "test10",
  "RegenieGWAS.genotypes_build": "hg19",
  "RegenieGWAS.chromosomes": ["1", "2"],

  "RegenieGWAS.genotypes_array_bed": "../tests/input/pipeline/example_step1.bed",
  "RegenieGWAS.genotypes_array_bim": "../tests/input/pipeline/example_step1.bim",
  "RegenieGWAS.genotypes_array_fam": "../tests/input/pipeline/example_step1.fam",

  "RegenieGWAS.genotypes_imputed": [
    {
      "file_prefix": "example",
      "primary_file": "../tests/input/pipeline/example.bgen",
      "secondary_file": "../tests/input/pipeline/example.bgen.bgi",
      "tertiary_file": "../tests/input/pipeline/example.sample",
      "chromosome": "ONE_FILE"
    }
  ],
  "RegenieGWAS.genotypes_imputed_format": "bgen",

  "RegenieGWAS.phenotypes_filename": "../tests/input/pipeline/phenotype.txt",
  "RegenieGWAS.phenotypes_columns": "Y1,Y2",
  "RegenieGWAS.phenotypes_binary_trait": false,

  "RegenieGWAS.regenie_premade_predictions": true,
  "RegenieGWAS.premade_prediction_files": [
    "../tests/input/regenie_step1_predictions/regenie_step1_out_pred.list",
    "../tests/input/regenie_step1_predictions/regenie_step1_out_1.loco.gz",
    "../tests/input/regenie_step1_predictions/regenie_step1_out_2.loco.gz"
  ],

  "RegenieGWAS.step2_gwas_split": true,
  "RegenieGWAS.step2_gwas_chunk_size": 250,
  "RegenieGWAS.regenie_gwas_test": "additive",
  "RegenieGWAS.make_chunks_sql": "../bin/get_intervals.sql",

  "RegenieGWAS.genes_bed": "../genes/genes.GRCh37.1-22.sorted.bed",
  "RegenieGWAS.genes_ranges": "../genes/glist-hg19-protein_coding",
  "RegenieGWAS.collapse_closegenes_py": "../bin/collapse_closegenes.py",

  "RegenieGWAS.clump_p1": 0.01,
  "RegenieGWAS.clump_p2": 0.05,
  "RegenieGWAS.annotation_min_log10p": 2,
  "RegenieGWAS.make_report": false
}
