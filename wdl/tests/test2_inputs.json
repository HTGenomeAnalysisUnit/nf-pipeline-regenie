{
  "## TEST 2": "BGEN input - step2 split - binary phenotype - 3 covars - report",

  "RegenieGWAS.project": "test2",
  "RegenieGWAS.genotypes_build": "hg19",
  "RegenieGWAS.chromosomes": ["1", "2"],

  "RegenieGWAS.genotypes_array_bed": "../tests/input/pipeline/example_step1.bed",
  "RegenieGWAS.genotypes_array_bim": "../tests/input/pipeline/example_step1.bim",
  "RegenieGWAS.genotypes_array_fam": "../tests/input/pipeline/example_step1.fam",

  "RegenieGWAS.genotypes_imputed": [
    {
      "file_prefix": "example",
      "primary_file": "../tests/input/pipeline/example.bgen",
      "secondary_file": "../tests/input/pipeline/example.bgen.bgi",
      "tertiary_file": "../tests/input/pipeline/example.sample",
      "chromosome": "ONE_FILE"
    }
  ],
  "RegenieGWAS.genotypes_imputed_format": "bgen",

  "RegenieGWAS.phenotypes_filename": "../tests/input/pipeline/phenotype_bin.txt",
