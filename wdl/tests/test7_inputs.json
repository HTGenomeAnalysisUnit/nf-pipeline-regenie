{
  "## TEST 7": "PGEN input - step2 split - quant phenotype",

  "RegenieGWAS.project": "test7",
  "RegenieGWAS.genotypes_build": "hg19",
  "RegenieGWAS.chromosomes": ["1", "2"],

  "RegenieGWAS.genotypes_array_bed": "../tests/input/pipeline/example_step1.bed",
  "RegenieGWAS.genotypes_array_bim": "../tests/input/pipeline/example_step1.bim",
  "RegenieGWAS.genotypes_array_fam": "../tests/input/pipeline/example_step1.fam",

  "RegenieGWAS.genotypes_imputed": [
    {
      "file_prefix": "example",
      "primary_file": "../tests/input/pipeline/example.pgen",
      "secondary_file": "../tests/input/pipeline/example.pvar",
      "tertiary_file": "../tests/input/pipeline/example.psam",
      "chromosome": "ONE_FILE"
    }
  ],
  "RegenieGWAS.genotypes_imputed_format": "pgen",

  "RegenieGWAS.phenotypes_filename": "../tests/input/pipeline/phenotype.txt",
